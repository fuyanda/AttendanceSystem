# 复制为 application-local.yml 后填写真实值
# application.yml 中 spring.profiles.active 需包含 local
token:
  secret: CHANGE_ME_JWT_SECRET

wx:
  appid: your-wechat-appid
  secret: your-wechat-secret
  templateId: "your-checkin-template-id"
  reviewTemplateId: "your-review-template-id"
  review-template-id: "your-review-template-id"
  h5BaseUrl: https://student.example.com
  apiBaseUrl: https://face.example.com/prod-api
  recordSignSecret: CHANGE_ME_RECORD_SIGN_SECRET

baidu:
  face:
    enabled: true
    app-id: "your-baidu-app-id"
    api-key: "your-baidu-api-key"
    secret-key: "your-baidu-secret-key"
    group-id: students_dev
    score-threshold: 80

spring:
  datasource:
    druid:
      master:
        url: jdbc:mysql://localhost:3306/your_db?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
        username: root
        password: your_db_password
      stat-view-servlet:
        login-username: admin
        login-password: CHANGE_ME_DRUID_PASSWORD
