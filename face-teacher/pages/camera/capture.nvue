  align-items: center;
}
.oval {
  width: 560rpx;
  height: 680rpx;
  border-width: 4rpx;
  border-style: dashed;
  border-color: rgba(34, 197, 94, 0.95);
  border-radius: 340rpx;
  background-color: rgba(34, 197, 94, 0.06);
}
.guide-text {
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 30rpx;
  text-align: center;
}
.tips {
  flex-direction: row;
  margin-top: 24rpx;
}
.tip {
  margin-left: 10rpx;
  margin-right: 10rpx;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  border-radius: 999rpx;
  background-color: rgba(15, 23, 42, 0.65);
  color: #e2e8f0;
  font-size: 22rpx;
}
.toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 180rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 48rpx;
  padding-right: 48rpx;
  background-color: rgba(15, 23, 42, 0.9);
}
.btn {
  height: 80rpx;
  line-height: 80rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  text-align: center;
}
.btn-cancel {
  color: #e2e8f0;
  background-color: rgba(255, 255, 255, 0.12);
}
.btn-shoot {
  color: #ffffff;
  background-color: #22c55e;
}
</style>
