  color: #ffffff;
  font-size: 26rpx;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 999rpx;
  background-color: rgba(34, 197, 94, 0.9);
}
