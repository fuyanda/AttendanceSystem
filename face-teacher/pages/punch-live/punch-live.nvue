<template>
  <view class="page">
    <live-pusher
      id="livePusher"
      ref="livePusher"
      class="pusher"
      url=""
      mode="FHD"
      :muted="true"
      :enable-camera="true"
      :enable-mic="false"
      :auto-focus="true"
      :device-position="devicePosition"
      beauty="0"
      whiteness="0"
      aspect="9:16"
      @statechange="onStateChange"
      @error="onError"
    />
    <view class="overlay">
      <view class="top-bar">
        <text class="btn-exit" @click="onExit">退出</text>
        <text class="mode-tag">常驻签到</text>
        <text class="btn-flip" @click="toggleCamera">{{ switching ? '切换中' : '切换' }}</text>
      </view>
      <view class="frame">
        <view class="oval" />
        <text class="status-text">{{ statusText }}</text>
      </view>
      <view class="tips">
        <text class="tip">正脸对准框内</text>
        <text class="tip">保持光线充足</text>
        <text class="tip">站稳稍候即可</text>
      </view>
    </view>
    <view class="toolbar">
      <view class="last-box">
        <text class="last-label">最近签到</text>
        <text class="last-name">{{ lastSuccessName || '—' }}</text>
        <text class="last-time">{{ lastSuccessTime || '等待识别' }}</text>
      </view>
      <text class="camera-tag">{{ cameraLabel }}</text>
    </view>
  </view>
</template>

<script>
import { requestCameraPermission } from '@/shared/utils/camera-permission.js'
import {
  getPreferredCameraPosition,
  setPreferredCameraPosition
} from '@/shared/utils/camera-preference.js'
import { createAutoPunchLoop } from '@/modules/punch-live/composables/autoPunchLoop.js'
import { speakCheckinSuccess, stopSpeaking } from '@/shared/utils/speech.js'

function pad2(n) {
  return n < 10 ? '0' + n : '' + n
}

function formatClock(date) {
  return pad2(date.getHours()) + ':' + pad2(date.getMinutes()) + ':' + pad2(date.getSeconds())
}

export default {
  data() {
    return {
      switching: false,
      previewStarted: false,
      devicePosition: 'back',
      statusText: '正在启动相机...',
      lastSuccessName: '',
      lastSuccessTime: '',
      noticeText: ''
    }
  },
  computed: {
    cameraLabel() {
      return this.devicePosition === 'back' ? '后置摄像头' : '前置摄像头'
    }
  },
  onLoad() {
    const preferred = getPreferredCameraPosition()
    this.devicePosition = preferred || 'back'
  },
  async onReady() {
    const granted = await requestCameraPermission()
    if (!granted) {
      uni.showToast({ title: '未获得相机权限', icon: 'none' })
      setTimeout(() => uni.navigateBack(), 600)
      return
    }
    this.setWakelock(true)
    this.context = uni.createLivePusherContext('livePusher', this)
    this.loop = createAutoPunchLoop({
      snapshot: () => this.takeSnapshot(),
      onStatus: (text) => {
        this.statusText = text
      },
      onSuccess: (payload) => {
        this.lastSuccessName = payload.studentName
        this.lastSuccessTime = formatClock(new Date())
        speakCheckinSuccess(payload.studentName)
        uni.showToast({ title: payload.studentName + ' 签到成功', icon: 'success' })
      },
      onNotice: (text) => {
        this.noticeText = text
      }
    })
    setTimeout(() => this.startPreview(), 200)
  },
  methods: {
    setWakelock(enabled) {
      // #ifdef APP-PLUS
      try {
        if (typeof plus !== 'undefined' && plus.device && plus.device.setWakelock) {
          plus.device.setWakelock(!!enabled)
        }
      } catch (e) {}
      // #endif
    },
    startPreview() {
      if (!this.context) return
      this.context.startPreview({
        success: () => {
          this.previewStarted = true
          this.statusText = '请将面部对准镜头'
          if (this.loop) this.loop.start()
        },
        fail: () => {
          this.statusText = '相机预览失败'
          uni.showToast({ title: '相机预览失败', icon: 'none' })
        }
      })
    },
    onStateChange(e) {
      const code = e.detail && e.detail.code
      if (code === 1007) {
        this.previewStarted = true
        if (this.loop && !this.loop.running) this.loop.start()
      }
    },
    onError(e) {
      const msg = (e.detail && e.detail.errMsg) || '相机不可用'
      this.statusText = msg
      uni.showToast({ title: msg, icon: 'none' })
    },
    takeSnapshot() {
      return new Promise((resolve) => {
        if (!this.context || !this.previewStarted) {
          resolve(null)
          return
        }
        this.context.snapshot({
          success: (res) => {
            const message = res.message || res
            const path =
              message.tempImagePath ||
              message.snapshotPath ||
              message.path ||
              res.tempImagePath ||
              null
            resolve(path || null)
          },
          fail: () => resolve(null)
        })
      })
    },
    askKeepCameraSetting() {
      uni.showModal({
        title: '提示',
        content: '是否保留当前设置？',
        confirmText: '保留',
        cancelText: '不保留',
        success: (res) => {
          if (res.confirm) {
            setPreferredCameraPosition(this.devicePosition)
            uni.showToast({ title: '已保存，下次打开将使用此摄像头', icon: 'none' })
          }
        }
      })
    },
    toggleCamera() {
      if (this.switching || !this.context) return
      this.switching = true
      if (this.loop) this.loop.stop()
      this.context.switchCamera({
        success: () => {
          this.devicePosition = this.devicePosition === 'front' ? 'back' : 'front'
          this.switching = false
          this.askKeepCameraSetting()
          if (this.loop) this.loop.start()
        },
        fail: () => {
          this.restartWithCamera(this.devicePosition === 'front' ? 'back' : 'front')
        }
      })
    },
    restartWithCamera(position) {
      if (!this.context) {
        this.switching = false
        return
      }
      this.context.stopPreview({
        complete: () => {
          this.devicePosition = position
          this.previewStarted = false
          setTimeout(() => {
            this.context.startPreview({
              success: () => {
                this.previewStarted = true
                this.switching = false
                this.askKeepCameraSetting()
                if (this.loop) this.loop.start()
              },
              fail: () => {
                uni.showToast({ title: '切换摄像头失败', icon: 'none' })
                this.switching = false
              }
            })
          }, 200)
        }
      })
    },
    onExit() {
      if (this.loop) this.loop.stop()
      uni.navigateBack()
    }
  },
  onUnload() {
    if (this.loop) this.loop.stop()
    stopSpeaking()
    if (this.context) {
      try {
        this.context.stopPreview()
      } catch (e) {}
    }
    this.setWakelock(false)
  }
}
</script>

