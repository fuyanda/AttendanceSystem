  color: #e2e8f0;
  font-size: 26rpx;
  font-weight: 600;
  padding-top: 10rpx;
  padding-bottom: 10rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  border-radius: 999rpx;
  background-color: rgba(15, 23, 42, 0.65);
}
.frame {
  align-items: center;
}
.oval {
  width: 560rpx;
  height: 680rpx;
  border-width: 4rpx;
  border-style: dashed;
  border-color: rgba(34, 197, 94, 0.95);
  border-radius: 340rpx;
  background-color: rgba(34, 197, 94, 0.06);
}
.status-text {
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 30rpx;
  text-align: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.tips {
  flex-direction: row;
  margin-top: 24rpx;
}
.tip {
  margin-left: 10rpx;
  margin-right: 10rpx;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  border-radius: 999rpx;
  background-color: rgba(15, 23, 42, 0.65);
  color: #e2e8f0;
  font-size: 22rpx;
}
.toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 40rpx;
  padding-right: 40rpx;
  background-color: rgba(15, 23, 42, 0.92);
}
.last-box {
  flex: 1;
}
.last-label {
  color: #94a3b8;
  font-size: 22rpx;
}
.last-name {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}
.last-time {
  margin-top: 6rpx;
  color: #93c5fd;
  font-size: 24rpx;
}
.camera-tag {
  color: #e2e8f0;
  font-size: 22rpx;
  padding-top: 10rpx;
  padding-bottom: 10rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.12);
}
</style>
