# 服务监听
HOST=0.0.0.0
PORT=8080

# InsightFace root（模型实际位于 {ROOT}/models/{MODEL}，内网拷贝整个 models/ 目录）
INSIGHTFACE_ROOT=.
INSIGHTFACE_MODEL=buffalo_sc

# 人脸库 SQLite 与上传图片目录
DATABASE_PATH=./data/face.db
UPLOAD_DIR=./data/uploads

# 1:N 搜索：返回 Top-K，相似度阈值（余弦相似度，buffalo 系列常用 0.35~0.45）
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.40

# 上传限制（字节）
MAX_UPLOAD_BYTES=5242880
